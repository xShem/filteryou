{
  "manifest_version": 3,
  "name": "YouTube Free Filter",
  "version": "1.0.0",
  "description": "Локальные фильтры YouTube без аккаунтов, подписок и платных функций.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Фильтры YouTube" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["filter-core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
