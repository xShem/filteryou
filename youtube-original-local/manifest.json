{
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "css": [
        "assets/index-BEl-xhzj.css",
        "local-edition.css"
      ],
      "js": [
        "assets/index.ts-loader-MLBTP4lF.js"
      ],
      "matches": [
